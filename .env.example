# Public origin used for canonical URLs, sitemap, robots, and social metadata.
# Leave empty for a local preview (noindex and an empty sitemap).
NEXT_PUBLIC_SITE_URL=

# Backend. Leave the whole block empty until Supabase and GitHub OAuth are ready.
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_MEDIA_BUCKET=project-media

# Add future server-only variables here and register them in src/env.ts.
# Secrets must never be prefixed with NEXT_PUBLIC_.
