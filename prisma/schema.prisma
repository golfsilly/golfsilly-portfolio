generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum ProjectLocale {
  th
  en

  @@schema("app")
}

enum ProjectTone {
  cyan
  violet
  amber

  @@schema("app")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
  @@schema("app")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("app")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
  @@schema("app")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("app")
}

model Project {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique
  sortOrder    Int                  @default(0)
  featured     Boolean              @default(false)
  sample       Boolean              @default(false)
  tone         ProjectTone          @default(cyan)
  stack        String[]
  imagePath    String?
  liveUrl      String?
  sourceUrl    String?
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]

  @@index([archivedAt, sortOrder])
  @@schema("app")
}

model ProjectTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  locale      ProjectLocale
  title       String
  category    String
  summary     String
  imageAlt    String
  problem     String
  role        String
  approach    String
  outcome     String
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale, publishedAt])
  @@schema("app")
}
